# Environment
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_workforce

# Redis
REDIS_URL=redis://localhost:6379

# JWT
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cookies
COOKIE_DOMAIN=localhost
# true in production (requires HTTPS)
COOKIE_SECURE=false

# Password reset / email verification token TTLs (seconds)
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Account lockout
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCKOUT_SECONDS=900

# Rate limiting (requests per window)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# Email provider: console | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=security@secureworkforce.dev

# CORS
CORS_ORIGIN=http://localhost:3000
